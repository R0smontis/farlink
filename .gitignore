# Xmake cache
.xmake/
.xmake-toolchain-cache/
build/
# Runtime logs written next to the working copy by the app and harnesses;
# never a source artifact, so they must not dirty the tree (which would also
# flip the build-identity state to "dirty").
logs/
apps/ios/Vendor/
apps/ios/DerivedData*/
apps/ios/.xmake/
xcuserdata/
*.xcuserstate

# MacOS Cache
.DS_Store

# VSCode cache
.vscode

# CLI npm dependencies
node_modules/
