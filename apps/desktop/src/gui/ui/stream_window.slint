// Reference menu palette (macOS light native NSMenu aesthetic, HDR-neutral).
global CcTheme {
    out property <color> surface: #f5f5f7f6;
    out property <color> border: #d2d2d7;
    out property <color> separator: #e2e2e6;
    out property <color> hover: #0000000d;
    out property <color> active: #00000014;
    out property <color> text: #1d1d1f;
    out property <color> muted: #86868b;
    out property <color> icon: #2c2c2e;
    out property <color> danger: #d92d20;
    out property <color> accent: #0a7aff;
    out property <color> topbar: #f6f6f8;
    out property <length> menu-radius: 10px;
    out property <length> row-radius: 6px;
}

component CcDivider inherits Rectangle {
    height: 9px;
    background: transparent;
    Rectangle {
        x: 12px; y: 4px;
        width: parent.width - 24px;
        height: 1px;
        background: CcTheme.separator;
    }
}

component CcSectionTitle inherits Rectangle {
    in property <string> label;
    height: 24px;
    background: transparent;
    Text {
        x: 12px; y: 6px;
        width: parent.width - 24px; height: 16px;
        text: root.label;
        font-size: 11px;
        font-weight: 500;
        color: CcTheme.muted;
        vertical-alignment: center;
    }
}

// Primary control-center menu row: 28px height, 14px left icon, 13px label,
// right-aligned muted shortcut hint or subtle chevron.
component CcMenuRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> hint: "";
    in property <bool> chevron: true;
    in property <bool> danger: false;
    in property <bool> highlighted: false;
    in property <bool> enabled: true;
    callback activated;
    callback hovered;

    height: 28px;
    border-radius: CcTheme.row-radius;
    background: !root.enabled ? transparent
        : touch.pressed ? CcTheme.active
        : (touch.has-hover || root.highlighted) ? CcTheme.hover : transparent;

    Text {
        x: 10px; width: 16px; height: parent.height;
        text: root.glyph;
        font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 13px;
        color: !root.enabled ? CcTheme.muted : root.danger ? CcTheme.danger : CcTheme.icon;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Text {
        x: 34px;
        width: parent.width - 34px - (root.hint != "" ? 86px : (root.chevron ? 24px : 10px));
        height: parent.height;
        text: root.label;
        font-size: 13px;
        color: !root.enabled ? CcTheme.muted : root.danger ? CcTheme.danger : CcTheme.text;
        vertical-alignment: center; overflow: elide;
    }
    if root.hint != "": Text {
        x: parent.width - 84px; width: 74px; height: parent.height;
        text: root.hint;
        font-size: 11px;
        color: CcTheme.muted;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if root.chevron: Text {
        x: parent.width - 20px; width: 14px; height: parent.height;
        text: "›";
        font-size: 15px;
        color: CcTheme.muted;
        horizontal-alignment: center; vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        moved => { if root.enabled { root.hovered(); } }
        changed has-hover => { if self.has-hover && root.enabled { root.hovered(); } }
        clicked => { if root.enabled { root.activated(); } }
        scroll-event(event) => { accept }
    }
}

// Submenu item: left gutter (26px) holds checkmark (✓), dot (•) or glyph;
// label 13px, optional muted description line 11px, optional right hint/chevron.
component CcSubItem inherits Rectangle {
    in property <string> label;
    in property <string> detail: "";
    in property <string> hint: "";
    in property <string> left-glyph: "";
    in property <bool> checked: false;
    in property <bool> radio-dot: false;
    in property <bool> chevron: false;
    in property <bool> highlighted: false;
    in property <bool> enabled: true;
    callback activated;
    callback hovered;

    private property <bool> has-detail: root.detail != "";
    height: root.has-detail ? max(46px, detail-text.preferred-height + 30px) : 28px;
    border-radius: CcTheme.row-radius;
    background: !root.enabled ? transparent
        : touch.pressed ? CcTheme.active
        : (touch.has-hover || root.highlighted) ? CcTheme.hover : transparent;

    if root.checked || root.radio-dot || root.left-glyph != "": Text {
        x: 6px; y: root.has-detail ? 6px : 0px;
        width: 18px; height: root.has-detail ? 18px : parent.height;
        text: root.radio-dot ? "•" : root.checked ? "✓" : root.left-glyph;
        font-family: root.left-glyph != "" && !root.checked && !root.radio-dot ? "Font Awesome 6 Free" : "";
        font-weight: root.left-glyph != "" && !root.checked && !root.radio-dot ? 900 : 600;
        font-size: root.radio-dot ? 16px : 12px;
        color: !root.enabled ? CcTheme.muted : CcTheme.text;
        horizontal-alignment: center; vertical-alignment: center;
    }

    Text {
        x: 26px; y: root.has-detail ? 6px : 0px;
        width: parent.width - 26px - (root.hint != "" ? 82px : (root.chevron ? 22px : 10px));
        height: root.has-detail ? 18px : parent.height;
        text: root.label;
        font-size: 13px;
        color: !root.enabled ? CcTheme.muted : CcTheme.text;
        vertical-alignment: center; overflow: elide;
    }
    if root.hint != "": Text {
        x: parent.width - 80px; y: root.has-detail ? 6px : 0px;
        width: 70px; height: root.has-detail ? 18px : parent.height;
        text: root.hint;
        font-size: 11px; color: CcTheme.muted;
        horizontal-alignment: right; vertical-alignment: center;
    }
    if root.chevron: Text {
        x: parent.width - 20px; y: root.has-detail ? 6px : 0px;
        width: 14px; height: root.has-detail ? 18px : parent.height;
        text: "›"; font-size: 15px; color: CcTheme.muted;
        horizontal-alignment: center; vertical-alignment: center;
    }
    detail-text := Text {
        visible: root.has-detail;
        x: 26px; y: 25px;
        width: parent.width - 36px;
        text: root.detail;
        font-size: 11px; color: CcTheme.muted;
        wrap: word-wrap;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        changed has-hover => { if self.has-hover && root.enabled { root.hovered(); } }
        clicked => { if root.enabled { root.activated(); } }
        scroll-event(event) => { accept }
    }
}

// Compact horizontal slider matching macOS menu slider aesthetic (volume / opacity / sensitivity).
component CcSliderRow inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <string> left-glyph: "";
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 100;
    callback edited(float);
    callback committed(float);
    callback icon-clicked;

    height: 36px;
    background: transparent;

    if root.left-glyph != "": Rectangle {
        x: 6px; y: 6px; width: 24px; height: 24px;
        border-radius: 5px;
        background: icon-touch.has-hover ? CcTheme.hover : transparent;
        Text {
            text: root.left-glyph;
            font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 12px;
            color: CcTheme.icon;
            horizontal-alignment: center; vertical-alignment: center;
        }
        icon-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.icon-clicked(); }
            scroll-event(event) => { accept }
        }
    }

    Text {
        x: root.left-glyph != "" ? 34px : 12px;
        y: 0px; width: 64px; height: parent.height;
        text: root.label;
        font-size: 12px; color: CcTheme.text;
        vertical-alignment: center; overflow: elide;
    }

    rail-hit := Rectangle {
        private property <length> left-edge: root.left-glyph != "" ? 94px : 78px;
        private property <length> right-reserve: root.value-text != "" ? 44px : 14px;
        x: self.left-edge;
        y: 6px;
        width: max(40px, parent.width - self.left-edge - self.right-reserve);
        height: 24px;
        background: transparent;

        private property <float> ratio:
            clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);

        Rectangle {
            x: 0px; y: 10px; width: parent.width; height: 4px;
            border-radius: 2px;
            background: #d1d1d6;
        }
        Rectangle {
            x: 0px; y: 10px;
            width: parent.width * parent.ratio;
            height: 4px;
            border-radius: 2px;
            background: CcTheme.accent;
        }
        Rectangle {
            x: (parent.width - 14px) * parent.ratio;
            y: 5px; width: 14px; height: 14px;
            border-radius: 7px;
            background: white;
            border-width: 1px; border-color: #c7c7cc;
        }
        slider-touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            function apply-at(mx: length) {
                let r = clamp(mx / max(1px, parent.width), 0, 1);
                let v = round(root.minimum + r * (root.maximum - root.minimum));
                if v != root.value {
                    root.value = v;
                    root.edited(v);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.apply-at(self.mouse-x);
                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    self.apply-at(self.mouse-x);
                    root.committed(root.value);
                }
            }
            moved => {
                if self.pressed { self.apply-at(self.mouse-x); }
            }
            scroll-event(event) => { accept }
        }
    }

    if root.value-text != "": Text {
        x: parent.width - 42px; y: 0px; width: 34px; height: parent.height;
        text: root.value-text;
        font-size: 11px; color: CcTheme.muted;
        horizontal-alignment: right; vertical-alignment: center;
    }
}

component CcMenuSurface inherits Rectangle {
    background: CcTheme.surface;
    border-radius: CcTheme.menu-radius;
    border-width: 1px;
    border-color: CcTheme.border;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000028;
    TouchArea {
        mouse-cursor: MouseCursor.default;
        scroll-event(event) => { accept }
    }
}

export component StreamWindow inherits Window {
    in property <string> session-title: "Farlink";
    title: root.session-title;
    icon: @image-url("../../../resources/linux/farlink_256x256.png");
    preferred-width: 1280px;
    preferred-height: 720px + (root.custom-titlebar ? 32px : 0px);
    min-width: 640px;
    min-height: 360px + (root.custom-titlebar ? 32px : 0px);
    no-frame: root.custom-titlebar;
    background: root.native-video-enabled
        ? transparent : root.custom-titlebar ? transparent : black;
    default-font-size: ImGuiFontStyle.base;

    in property <bool> custom-titlebar: false;
    // True when the host platform embeds the window-mode "控制中心" button inside
    // its native titlebar (macOS NSTitlebarAccessoryViewController). False on
    // platforms that render the Slint topbar inside the window surface.
    in property <bool> native-titlebar-control: false;
    in property <bool> control-hand-cursor-supported: true;
    in property <bool> native-video-enabled: false;

    private property <length> titlebar-height:
        root.custom-titlebar && !root.fullscreen-enabled ? 32px
        : (!root.native-titlebar-control && !root.fullscreen-enabled ? 32px : 0px);
    private property <length> window-corner-radius: 12px;

    out property <length> video-area-top: content-layer.y + video.y;
    out property <length> video-area-width: video.width;
    out property <length> video-area-height: video.height;
    in property <bool> window-active: true;
    in property <bool> window-maximized: false;
    out property <bool> video-input-focused: input-focus.has-focus;
    in property <image> frame;
    in property <bool> has-frame: false;
    in property <string> status-text: "";
    in property <string> receiving-text: "";
    in property <string> service-warning: "";
    private property <bool> service-warning-expired: false;
    changed service-warning => {
        if root.service-warning == "" { root.service-warning-expired = false; }
    }
    in property <bool> remote-update-visible: false;
    in property <bool> privacy-unlock-visible: false;
    in property <bool> privacy-can-lock: false;
    out property <bool> modal-visible: root.remote-update-visible || root.privacy-unlock-visible
        || root.bitrate-editor-open || root.network-settings-open;
    callback dismiss-privacy-unlock;
    callback lock-privacy;
    callback dismiss-remote-update;

    in property <[string]> displays;
    in-out property <int> selected-display: 0;
    in property <bool> mouse-control-enabled: true;
    in property <bool> game-mouse-available: false;
    in property <bool> game-mouse-active: false;
    callback toggle-game-mouse;
    callback release-pointer;

    private property <bool> game-mouse-notice-expired: false;
    changed game-mouse-active => {
        if root.game-mouse-active {
            root.game-mouse-notice-expired = false;
            game-mouse-notice-timer.running = true;
            game-mouse-notice-timer.restart();
        } else {
            game-mouse-notice-timer.running = false;
        }
    }
    game-mouse-notice-timer := Timer {
        interval: 4s;
        running: false;
        triggered => {
            self.running = false;
            root.game-mouse-notice-expired = true;
        }
    }
    out property <bool> game-mouse-notice-visible:
        root.game-mouse-active && !root.game-mouse-notice-expired;

    in property <bool> privacy-visible: true;
    in property <bool> privacy-can-toggle: false;
    in property <bool> privacy-active: false;
    in property <bool> privacy-off: false;
    in property <bool> privacy-unsupported: false;
    in property <string> privacy-status-text: "Privacy screen";

    in property <bool> remote-cursor-active: false;
    in property <int> remote-cursor-shape: 0;
    in property <bool> audio-enabled: true;
    in-out property <float> audio-volume-percent: 100;
    callback change-audio-volume(int);

    // Video settings: reference logic — Bitrate Tiers + Frame Rate + True Color.
    // Legacy quality (Low/Med/High) and preference (fps/quality/balanced) UI are
    // removed; the wire still carries High + Balanced while bitrate tiers govern bandwidth.
    in property <bool> video-settings-enabled: false;
    in property <bool> high-fps-supported: false;
    in property <int> display-max-frame-rate: 144;
    in property <string> video-settings-feedback: "";
    in-out property <int> video-quality-index: 2;
    in-out property <int> frame-rate-index: 1;
    in-out property <int> adaptation-policy-index: 1;
    callback change-video-settings(int, int, int);

    in property <bool> bitrate-cap-enabled: false;
    in property <[BitrateTierEntry]> bitrate-tiers: [
        { name: "自动（原画）", mbps: 0, label: "自动（原画）" },
        { name: "原画", mbps: 30, label: "原画 30M" },
        { name: "超清", mbps: 14, label: "超清 14M" },
        { name: "高清", mbps: 8, label: "高清 8M" },
    ];
    in-out property <int> bitrate-cap-index: 0;
    callback choose-bitrate-cap(int);
    callback add-bitrate-tier(string, int);
    callback update-bitrate-tier(int, string, int);
    callback remove-bitrate-tier(int);
    callback reset-bitrate-tiers;
    in-out property <bool> bitrate-editor-open: false;
    private property <string> new-tier-name: "";
    private property <string> new-tier-mbps: "50";
    private property <string> tier-editor-error: "";

    in property <bool> host-mute-supported: false;
    in-out property <bool> host-mute-enabled: false;
    callback toggle-host-mute(bool);
    in property <bool> true-color-enabled;
    callback toggle-true-color(bool);
    in property <bool> host-lock-on-disconnect: false;
    callback toggle-host-lock-on-disconnect(bool);
    in property <bool> force-relay-enabled: false;
    callback toggle-force-relay(bool);

    // Display fit mode: false = adaptive fit, true = actual size 1:1.
    in-out property <bool> window-scale-actual: false;
    in-out property <float> mouse-sensitivity-percent: 100;
    in-out property <float> wheel-sensitivity-percent: 100;
    in property <string> sensitivity-error;
    in property <bool> diagnostic-exporting: false;
    in property <string> diagnostic-feedback: "";
    callback export-diagnostics;
    in property <bool> keyboard-shortcut-row-visible: false;
    in property <int> keyboard-shortcut-index: 0;
    callback choose-keyboard-shortcut(int);
    callback save-input-sensitivity(int, int);
    function commit-input-sensitivity() {
        root.save-input-sensitivity(round(root.mouse-sensitivity-percent), round(root.wheel-sensitivity-percent));
    }

    in property <[string]> remote-resolutions;
    in property <bool> remote-resolution-visible: false;
    in property <int> remote-resolution-index: -1;
    in property <bool> remote-resolution-enabled: false;
    in property <string> remote-resolution-feedback: "";
    callback change-remote-resolution(int);

    in property <bool> fullscreen-enabled: false;
    in-out property <bool> fullscreen-transitioning: false;
    pure callback fullscreen-video-inset(length, length) -> length;
    Timer {
        running: root.fullscreen-transitioning;
        interval: 5s;
        triggered => { root.fullscreen-transitioning = false; }
    }

    // Network status overlay & customization state (persisted in ConfigCenter).
    in-out property <bool> stats-visible: false;
    in property <string> network-overlay-text: "";
    in property <int> network-quality: 0;
    in property <string> network-summary: "";
    in property <[NetworkStatsRow]> stats-rows;
    in property <string> stats-fps: "0";
    in property <string> stats-resolution: "";
    in property <string> stats-video-latency: "—";
    in property <string> stats-connection-latency: "—";
    in property <string> stats-connection-mode: "";
    in property <string> stats-local-endpoint;
    in property <string> stats-remote-endpoint;
    in property <string> stats-encoder: "—";
    in property <string> stats-decoder: "—";
    in property <bool> stats-encryption-enabled: false;
    in property <string> stats-freeze-count: "—";
    in property <string> stats-freezes-per-min: "—";
    in property <string> stats-freeze-max: "—";
    in property <string> stats-interval-p95: "—";
    in property <string> stats-video-jitter: "—";
    in property <string> stats-audio-jitter: "—";
    in property <string> stats-decode-ms: "—";
    in property <string> stats-render-ms: "—";

    in-out property <float> overlay-x-ratio: 0.015;
    in-out property <float> overlay-y-ratio: 0.03;
    in-out property <length> overlay-width: 136px;
    in-out property <length> overlay-height: 186px;
    in-out property <int> overlay-font-size: 11;
    in-out property <int> overlay-opacity-percent: 78;
    in-out property <int> overlay-layout-mode: 0; // 0 vertical, 1 compact horizontal
    in-out property <bool> overlay-show-clock: true;
    in-out property <bool> overlay-show-transport: true;
    in-out property <bool> overlay-show-fps: true;
    in-out property <bool> overlay-show-bitrate: true;
    in-out property <bool> overlay-show-rtt: true;
    in-out property <bool> overlay-show-frame-latency: true;
    in-out property <bool> overlay-show-loss: true;
    in-out property <bool> overlay-show-resolution-tier: true;
    in-out property <bool> overlay-show-codec: false;
    in-out property <bool> overlay-show-endpoints: false;
    in-out property <bool> network-settings-open: false;
    callback save-network-overlay-config;
    callback reset-network-overlay-config;

    // Control center state (shared between windowed titlebar button & fullscreen ball).
    in-out property <bool> control-center-open: false;
    in-out property <length> cc-anchor-x: 0px;
    private property <int> cc-submenu: -1;
    // Nested 3rd-level flyouts:
    //   0 = none, 1 = other resolutions, 2 = privacy modes, 3 = mouse mode
    private property <int> cc-sub3: 0;
    callback control-center-state-changed(bool);
    changed control-center-open => {
        if !root.control-center-open {
            root.cc-submenu = -1;
            root.cc-sub3 = 0;
            root.commit-input-sensitivity();
        }
        root.control-center-state-changed(root.control-center-open);
    }
    public function toggle-control-center-at(anchor-x: length) {
        if anchor-x > 0px {
            root.cc-anchor-x = anchor-x;
        }
        root.control-center-open = !root.control-center-open;
        if root.control-center-open {
            root.cc-submenu = -1;
            root.cc-sub3 = 0;
        }
    }

    // Fullscreen floating ball state (visible ONLY in fullscreen mode).
    private property <length> ball-size: 38px;
    private property <bool> ball-docked-right: true;
    private property <length> ball-pos-y: 120px;
    private property <bool> ball-dragging: false;
    private property <bool> ball-drag-pending: false;
    private property <length> ball-drag-start-x: 0px;
    private property <length> ball-drag-start-y: 0px;
    private property <length> ball-drag-x: 0px;
    private property <length> ball-press-x: 0px;
    private property <length> ball-press-y: 0px;
    private property <bool> ball-hovered: false;
    private property <bool> ball-idle: false;
    private property <bool> ball-can-idle: root.fullscreen-enabled && !root.control-center-open
        && !root.ball-dragging && !root.ball-drag-pending && !root.ball-hovered;
    changed ball-can-idle => { if !root.ball-can-idle { root.ball-idle = false; } }
    Timer {
        interval: 3s;
        running: root.ball-can-idle && !root.ball-idle;
        triggered => { root.ball-idle = true; }
    }
    private property <length> ball-x: root.ball-dragging ? root.ball-drag-x
        : root.ball-docked-right
            ? video.width - root.ball-size + (root.ball-idle ? 16px : -10px)
            : (root.ball-idle ? -16px : 10px);
    private property <length> ball-y: clamp(root.ball-pos-y, 12px, max(12px, video.height - root.ball-size - 12px));

    // Network overlay drag/resize state.
    private property <bool> overlay-dragging: false;
    private property <bool> overlay-resizing: false;
    private property <length> overlay-drag-offset-x: 0px;
    private property <length> overlay-drag-offset-y: 0px;
    private property <length> overlay-resize-start-w: 136px;
    private property <length> overlay-resize-start-h: 186px;
    private property <length> overlay-resize-start-mx: 0px;
    private property <length> overlay-resize-start-my: 0px;
    private property <length> overlay-x:
        clamp(root.overlay-x-ratio * max(1px, video.width - root.overlay-width),
              4px, max(4px, video.width - root.overlay-width - 4px));
    private property <length> overlay-y:
        clamp(root.overlay-y-ratio * max(1px, video.height - root.overlay-height),
              4px, max(4px, video.height - root.overlay-height - 4px));

    in property <bool> file-transfer-visible: false;
    in property <[FileTransferEntry]> file-transfers;
    private property <length> file-panel-x: 18px;
    private property <length> file-panel-y: video.height - min(210px, video.height * 0.35);
    private property <length> file-panel-width: min(430px, video.width * 0.6);
    private property <length> file-panel-height: min(190px, video.height * 0.32);

    in property <bool> secure-attention-supported: false;
    callback switch-display(int);
    callback send-shortcut(string);
    callback toggle-mouse-control;
    callback toggle-privacy;
    callback toggle-audio;
    callback select-file;
    callback close-file-transfer;
    pure callback can-drop-file(data-transfer) -> bool;
    callback file-dropped(data-transfer);
    callback toggle-stats;
    callback copy-stats;
    callback toggle-fullscreen;
    callback disconnect;
    callback stream-title-drag(int, length, length);
    callback minimize-stream-window;
    callback toggle-maximize-stream-window;
    callback close-stream-window;
    callback pointer-input(PointerEventButton, PointerEventKind, length, length);
    callback scroll-input(length, length, length, length);
    callback key-input(string, bool, bool, bool, bool, bool);
    callback keyboard-focus-changed(bool);
    pure callback is-local-control-area(length, length) -> bool;
    callback place-control-pointer(length, length) -> bool;

    private property <bool> control-menu-open: root.control-center-open;
    out property <bool> local-input-active: root.modal-visible || root.control-menu-open;
    changed control-menu-open => {
        root.keyboard-focus-changed(!root.control-menu-open && !root.modal-visible && input-focus.has-focus);
    }
    changed selected-display => { root.cc-submenu = -1; root.cc-sub3 = 0; }
    changed fullscreen-enabled => {
        root.control-center-open = false;
    }

    private property <bool> awaiting-control-hover;
    private property <length> native-target-x;
    private property <length> native-target-y;
    private property <length> native-approach-distance: -1px;
    private property <bool> remote-left-down: false;
    private property <bool> remote-right-down: false;
    private property <bool> remote-middle-down: false;
    private property <bool> remote-pointer-active:
        root.remote-left-down || root.remote-right-down || root.remote-middle-down;

    function close-control-menus() {
        root.control-center-open = false;
        root.cc-submenu = -1;
        root.cc-sub3 = 0;
    }

    function cancel-remote-pointer() {
        root.remote-left-down = false;
        root.remote-right-down = false;
        root.remote-middle-down = false;
    }
    function remote-button-down(button: PointerEventButton) -> bool {
        return button == PointerEventButton.left ? root.remote-left-down
            : button == PointerEventButton.right ? root.remote-right-down
            : button == PointerEventButton.middle ? root.remote-middle-down : false;
    }
    public function reset-pressed-input() {
        root.cancel-remote-pointer();
    }
    public function reset-input-state() {
        root.close-control-menus();
        root.cancel-remote-pointer();
        root.clear-control-handoff();
    }
    function set-remote-button(button: PointerEventButton, down: bool) {
        if button == PointerEventButton.left { root.remote-left-down = down; }
        if button == PointerEventButton.right { root.remote-right-down = down; }
        if button == PointerEventButton.middle { root.remote-middle-down = down; }
    }
    function clear-control-handoff() {
        root.awaiting-control-hover = false;
        root.native-approach-distance = -1px;
    }
    function hand-off-control-pointer(px: length, py: length, place-native: bool) -> bool {
        if !RemoteCursor.adjusted || !root.is-local-control-area(
            RemoteCursor.adjusted-x, RemoteCursor.adjusted-y) { return false; }
        let x = RemoteCursor.adjusted-x;
        let y = RemoteCursor.adjusted-y;
        RemoteCursor.reset();
        RemoteCursor.outside-video = true;
        if place-native {
            root.awaiting-control-hover = root.place-control-pointer(x, root.video-area-top + y);
            if !root.awaiting-control-hover {
                root.native-target-x = x;
                root.native-target-y = y;
                root.native-approach-distance = abs(px - x) + abs(py - y);
            }
        }
        return true;
    }
    function approaching-native-control(x: length, y: length) -> bool {
        if root.native-approach-distance < 0px { return false; }
        let distance = abs(x - root.native-target-x) + abs(y - root.native-target-y);
        if distance > root.native-approach-distance {
            root.native-approach-distance = -1px;
            return false;
        }
        root.native-approach-distance = distance;
        return true;
    }
    function route-remote-pointer(button: PointerEventButton, kind: PointerEventKind,
        x: length, y: length) {
        if kind == PointerEventKind.cancel {
            root.cancel-remote-pointer();
        } else if kind == PointerEventKind.up {
            if root.remote-button-down(button) {
                root.set-remote-button(button, false);
                root.pointer-input(button, kind, x, y);
                if !root.remote-pointer-active { root.hand-off-control-pointer(x, y, true); }
            }
        } else if root.window-active && root.mouse-control-enabled && !root.modal-visible && !root.control-menu-open {
            let remote-target = root.remote-pointer-active
                || !root.is-local-control-area(x, y);
            if kind == PointerEventKind.down && remote-target
                && button != PointerEventButton.other && !root.awaiting-control-hover {
                root.native-approach-distance = -1px;
                let already-grabbed = root.remote-pointer-active;
                input-focus.focus();
                root.set-remote-button(button, true);
                root.pointer-input(button, kind, x, y);
                if !already-grabbed && root.hand-off-control-pointer(x, y, false) {
                    root.set-remote-button(button, false);
                }
            } else if kind == PointerEventKind.move && remote-target && !root.game-mouse-active {
                root.awaiting-control-hover = false;
                if root.approaching-native-control(x, y) { return; }
                root.pointer-input(button, kind, x, y);
                if !root.remote-pointer-active { root.hand-off-control-pointer(x, y, true); }
            }
        }
    }
    function route-remote-scroll(dx: length, dy: length, x: length, y: length) {
        if root.window-active && root.mouse-control-enabled && !root.control-menu-open && !root.modal-visible
            && !root.awaiting-control-hover && !root.is-local-control-area(x, y) {
            root.native-approach-distance = -1px;
            root.scroll-input(dx, dy, x, y);
            if !root.remote-pointer-active { root.hand-off-control-pointer(x, y, false); }
        }
    }

    changed window-active => {
        if !root.window-active {
            root.close-control-menus();
            root.cancel-remote-pointer();
            root.ball-drag-pending = false;
            root.ball-dragging = false;
        }
    }
    changed mouse-control-enabled => {
        if !root.mouse-control-enabled { root.cancel-remote-pointer(); }
    }
    changed modal-visible => {
        if root.modal-visible {
            root.close-control-menus();
        }
        root.keyboard-focus-changed(!root.control-menu-open && !root.modal-visible && input-focus.has-focus);
    }

    // Menu panel geometry:
    // Windowed: right-aligned under the titlebar "控制中心" button.
    // Fullscreen: anchored beside the floating ball.
    private property <length> cc-menu-width: 286px;
    private property <length> cc-menu-height: 344px;
    private property <length> cc-menu-x: root.fullscreen-enabled
        ? (root.ball-docked-right
            ? max(8px, root.ball-x - root.cc-menu-width - 8px)
            : min(video.width - root.cc-menu-width - 8px, root.ball-x + root.ball-size + 8px))
        : clamp(
            (root.cc-anchor-x > 0px ? root.cc-anchor-x - root.cc-menu-width : video.width - root.cc-menu-width - 8px),
            8px, max(8px, video.width - root.cc-menu-width - 8px));
    private property <length> cc-menu-y: root.fullscreen-enabled
        ? clamp(root.ball-y, 8px, max(8px, video.height - root.cc-menu-height - 8px))
        : 6px;

    // Flyout placement: prefer right of cc-menu; flip left when squeezed by screen edge.
    pure function flyout-x(w: length) -> length {
        return root.cc-menu-x + root.cc-menu-width + 4px + w <= video.width - 6px
            ? root.cc-menu-x + root.cc-menu-width + 4px
            : max(6px, root.cc-menu-x - w - 4px);
    }
    pure function flyout-y(preferred-y: length, h: length) -> length {
        return clamp(preferred-y, 6px, max(6px, video.height - h - 6px));
    }

    is-local-control-area(pointer-x, pointer-y) => {
        if root.modal-visible || root.control-center-open { return true; }
        let over-ball = root.fullscreen-enabled
            && pointer-x >= root.ball-x && pointer-x <= root.ball-x + root.ball-size
            && pointer-y >= root.ball-y && pointer-y <= root.ball-y + root.ball-size;
        let over-overlay = root.stats-visible
            && pointer-x >= root.overlay-x && pointer-x <= root.overlay-x + root.overlay-width
            && pointer-y >= root.overlay-y && pointer-y <= root.overlay-y + root.overlay-height;
        let over-file-panel = root.file-transfer-visible
            && pointer-x >= root.file-panel-x && pointer-x <= root.file-panel-x + root.file-panel-width
            && pointer-y >= root.file-panel-y && pointer-y <= root.file-panel-y + root.file-panel-height;
        return over-ball || over-overlay || over-file-panel;
    }

    // Current display label for row 0 ("显示屏 1 (Built-in Retina Display)")
    private property <string> current-display-label:
        root.selected-display >= 0 && root.selected-display < root.displays.length
            ? root.displays[root.selected-display]
            : "显示屏 " + (root.selected-display + 1);

    window-surface := Rectangle {
        width: root.width;
        height: root.height;
        background: root.native-video-enabled ? transparent : black;
        border-radius:
            root.custom-titlebar && !root.fullscreen-enabled && !root.window-maximized
                ? root.window-corner-radius : 0px;
        clip: root.custom-titlebar && !root.fullscreen-enabled;

        // Window-mode topbar when platform does not embed the button into the
        // native AppKit titlebar (Windows / Linux / non-native fallback).
        if !root.native-titlebar-control && !root.fullscreen-enabled: Rectangle {
            x: 0px; y: 0px;
            width: parent.width;
            height: root.titlebar-height;
            background: CcTheme.topbar;
            z: 100;

            Text {
                x: 12px;
                width: max(0px, topbar-cc-btn.x - 20px);
                height: parent.height;
                text: root.session-title;
                color: root.window-active ? CcTheme.text : CcTheme.muted;
                font-size: 12px; font-weight: 600;
                vertical-alignment: center; overflow: elide;
            }
            if root.custom-titlebar: TouchArea {
                x: 0px; width: max(0px, topbar-cc-btn.x - 4px); height: parent.height;
                property <int> phase: self.pressed ? 1 : 0;
                changed phase => { root.stream-title-drag(phase, self.mouse-x, self.mouse-y); }
                moved => { if self.pressed { root.stream-title-drag(2, self.mouse-x, self.mouse-y); } }
                double-clicked => { root.toggle-maximize-stream-window(); }
            }

            // "控制中心" button sitting inside the window topbar (reference image #1:
            // rounded 6px rect, 24px tall, icon + label, subtle fill on hover/active).
            topbar-cc-btn := Rectangle {
                x: root.custom-titlebar ? parent.width - 122px - self.width : parent.width - self.width - 10px;
                y: (parent.height - self.height) / 2;
                width: 86px; height: 24px;
                border-radius: 6px;
                background: root.control-center-open ? CcTheme.active
                    : topbar-cc-touch.has-hover ? CcTheme.hover : transparent;
                Text {
                    x: 8px; width: 14px; height: parent.height;
                    text: "\u{f1de}";
                    font-family: "Font Awesome 6 Free"; font-weight: 900; font-size: 11px;
                    color: CcTheme.icon;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                Text {
                    x: 25px; width: parent.width - 31px; height: parent.height;
                    text: StreamStrings.control-center;
                    font-size: 12px; font-weight: 500; color: CcTheme.text;
                    vertical-alignment: center;
                }
                topbar-cc-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.toggle-control-center-at(topbar-cc-btn.x + topbar-cc-btn.width);
                    }
                    scroll-event(event) => { accept }
                }
            }

            if root.custom-titlebar: Rectangle {
                x: parent.width - 114px; y: 4px; width: 24px; height: 24px; border-radius: 12px;
                background: min-t.pressed ? #c0bfbc : min-t.has-hover ? #deddda : #e6e6e6;
                Rectangle { x: 8px; y: 12px; width: 8px; height: 1px; background: #454545; }
                min-t := TouchArea { clicked => { root.minimize-stream-window(); } }
            }
            if root.custom-titlebar: Rectangle {
                x: parent.width - 74px; y: 4px; width: 24px; height: 24px; border-radius: 12px;
                background: max-t.pressed ? #c0bfbc : max-t.has-hover ? #deddda : #e6e6e6;
                Rectangle { x: 8px; y: 8px; width: 8px; height: 8px; border-width: 1px; border-color: #454545; background: transparent; }
                max-t := TouchArea { clicked => { root.toggle-maximize-stream-window(); } }
            }
            if root.custom-titlebar: Rectangle {
                x: parent.width - 34px; y: 4px; width: 24px; height: 24px; border-radius: 12px;
                background: cls-t.pressed ? #b2161d : cls-t.has-hover ? #e01b24 : #e6e6e6;
                Path {
                    width: 24px; height: 24px; viewbox-width: 24; viewbox-height: 24;
                    commands: "M 14.75 14.75 L 8.25 8.25 M 14.75 8.25 L 8.25 14.75";
                    stroke: cls-t.has-hover || cls-t.pressed ? white : #454545; stroke-width: 1px;
                }
                cls-t := TouchArea { clicked => { root.close-stream-window(); } }
            }
            SurfaceSeparator { y: parent.height - 1px; height: 1px; outline-color: UiSurface.separator; }
        }

        content-layer := Rectangle {
            y: root.titlebar-height;
            width: parent.width;
            height: parent.height - self.y;
            background: root.native-video-enabled ? transparent : black;
            clip: true;

            video := Rectangle {
                y: 0px;
                height: parent.height;
                width: parent.width;
                background: root.native-video-enabled ? transparent : black;
                clip: true;

                frame-image := Image {
                    y: root.fullscreen-transitioning ? root.fullscreen-video-inset(root.width, root.height) : 0px;
                    width: parent.width;
                    height: parent.height - self.y;
                    source: root.frame;
                    image-fit: contain;
                    visible: root.has-frame && !root.native-video-enabled;
                }

                Text {
                    visible: !root.has-frame && (root.receiving-text != "" || root.status-text != "");
                    text: root.receiving-text != "" ? root.receiving-text : root.status-text;
                    color: root.receiving-text != "" ? #ffffffea : white;
                    font-size: root.receiving-text != "" ? 14px : ImGuiFontStyle.prominent;
                    horizontal-alignment: center; vertical-alignment: center;
                }

                drop-zone := DropArea {
                    can-drop(event) => {
                        return !root.modal-visible && root.can-drop-file(event.data)
                            ? DragAction.copy : DragAction.none;
                    }
                    dropped(event) => {
                        if root.modal-visible { return DragAction.none; }
                        root.file-dropped(event.data);
                        return DragAction.copy;
                    }
                }

                input-focus := FocusScope {
                    focus-on-click: true;
                    focus-gained => { root.keyboard-focus-changed(!root.control-menu-open && !root.modal-visible); }
                    focus-lost => { root.keyboard-focus-changed(false); }
                    key-pressed(event) => {
                        if !root.modal-visible && !root.control-menu-open {
                            root.key-input(event.text, true, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                        }
                        accept
                    }
                    key-released(event) => {
                        if root.modal-visible {
                            if event.text == Key.Escape {
                                if root.bitrate-editor-open { root.bitrate-editor-open = false; }
                                else if root.network-settings-open { root.network-settings-open = false; }
                                else if root.privacy-unlock-visible { root.dismiss-privacy-unlock(); }
                                else { root.dismiss-remote-update(); }
                            } else if event.text == Key.Return {
                                if root.privacy-unlock-visible { root.dismiss-privacy-unlock(); }
                                else if root.remote-update-visible { root.dismiss-remote-update(); }
                            }
                        } else if root.control-menu-open {
                            if event.text == Key.Escape { root.close-control-menus(); }
                        } else {
                            root.key-input(event.text, false, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                        }
                        accept
                    }
                    pointer := TouchArea {
                        private property <bool> over-local-control: root.is-local-control-area(self.mouse-x, self.mouse-y);
                        private property <bool> remote-hover-or-grab: root.remote-pointer-active
                            || (self.has-hover && !self.over-local-control);
                        mouse-cursor: root.game-mouse-active ? MouseCursor.none
                            : self.over-local-control && !root.remote-pointer-active ? MouseCursor.default
                            : RemoteCursor.adjusted && root.mouse-control-enabled ? MouseCursor.none : root.remote-cursor-active
                            ? RemoteCursor.shape(root.remote-cursor-shape) : MouseCursor.default;
                        changed remote-hover-or-grab => {
                            if !self.remote-hover-or-grab {
                                root.clear-control-handoff();
                                RemoteCursor.reset();
                            }
                        }
                        pointer-event(event) => {
                            root.route-remote-pointer(event.button, event.kind, self.mouse-x, self.mouse-y);
                        }
                        scroll-event(event) => {
                            root.route-remote-scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y);
                            accept
                        }
                    }
                }

                // Active remote button grab or fullscreen floating-ball drag capture.
                if root.remote-pointer-active || root.ball-drag-pending: TouchArea {
                    z: 15;
                    mouse-cursor: root.ball-drag-pending ? MouseCursor.pointer
                        : RemoteCursor.adjusted ? MouseCursor.none
                        : root.remote-cursor-active ? RemoteCursor.shape(root.remote-cursor-shape)
                        : MouseCursor.default;
                    pointer-event(event) => {
                        if root.ball-drag-pending {
                            if event.kind == PointerEventKind.move {
                                if !root.ball-dragging && (abs(self.mouse-x - root.ball-drag-start-x) > 4px
                                    || abs(self.mouse-y - root.ball-drag-start-y) > 4px) {
                                    root.ball-dragging = true;
                                    root.ball-drag-x = root.ball-x;
                                    root.control-center-open = false;
                                }
                                if root.ball-dragging {
                                    root.ball-drag-x = clamp(self.mouse-x - root.ball-press-x, 0px, max(0px, video.width - root.ball-size));
                                    root.ball-pos-y = clamp(self.mouse-y - root.ball-press-y, 12px, max(12px, video.height - root.ball-size - 12px));
                                }
                            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                let was-dragging = root.ball-dragging;
                                if was-dragging {
                                    root.ball-docked-right = root.ball-drag-x + root.ball-size / 2 >= video.width / 2;
                                }
                                root.ball-dragging = false;
                                root.ball-drag-pending = false;
                                if !was-dragging && event.kind == PointerEventKind.up {
                                    root.control-center-open = !root.control-center-open;
                                }
                            }
                        } else {
                            root.route-remote-pointer(event.button, event.kind, self.mouse-x, self.mouse-y);
                        }
                    }
                    scroll-event(event) => {
                        if !root.ball-drag-pending {
                            root.route-remote-scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y);
                        }
                        accept
                    }
                }

                if pointer.remote-hover-or-grab && root.mouse-control-enabled && !root.modal-visible && !root.control-menu-open: AdjustedPointer {
                    z: 16; shape: root.remote-cursor-active ? root.remote-cursor-shape : 0;
                }

                // =============================================================
                // Network status overlay: draggable, resizable (bottom-right handle),
                // customizable font size, opacity, layout, and fields.
                // Default visual matches Image #8 (136x186, #787878 at opacity,
                // Menlo 11px white monospace lines, 8px radius).
                // =============================================================
                if root.stats-visible: network-card := Rectangle {
                    x: root.overlay-x;
                    y: root.overlay-y;
                    width: root.overlay-width;
                    height: root.overlay-height;
                    border-radius: 8px;
                    background: #202226;
                    opacity: clamp(root.overlay-opacity-percent, 20, 100) / 100.0;
                    border-width: (overlay-drag-touch.has-hover || overlay-resize-touch.has-hover || root.overlay-dragging || root.overlay-resizing) ? 1px : 0px;
                    border-color: #ffffff55;
                    clip: true;
                    z: 9;

                    overlay-drag-touch := TouchArea {
                        mouse-cursor: root.overlay-dragging ? MouseCursor.grabbing : MouseCursor.grab;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.overlay-dragging = true;
                                root.overlay-drag-offset-x = self.mouse-x;
                                root.overlay-drag-offset-y = self.mouse-y;
                            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                if root.overlay-dragging {
                                    root.overlay-dragging = false;
                                    root.save-network-overlay-config();
                                }
                            }
                        }
                        moved => {
                            if root.overlay-dragging {
                                let nx = clamp(network-card.x + self.mouse-x - root.overlay-drag-offset-x,
                                               4px, max(4px, video.width - root.overlay-width - 4px));
                                let ny = clamp(network-card.y + self.mouse-y - root.overlay-drag-offset-y,
                                               4px, max(4px, video.height - root.overlay-height - 4px));
                                root.overlay-x-ratio = nx / max(1px, video.width - root.overlay-width);
                                root.overlay-y-ratio = ny / max(1px, video.height - root.overlay-height);
                            }
                        }
                        scroll-event(event) => { accept }
                    }

                    Text {
                        x: 10px; y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        text: root.network-overlay-text;
                        font-family: "Menlo";
                        font-size: root.overlay-font-size * 1px;
                        color: #f4f4f6;
                        wrap: root.overlay-layout-mode == 1 ? word-wrap : no-wrap;
                        overflow: clip;
                    }

                    // Bottom-right resize grip (visible on hover/drag).
                    Rectangle {
                        x: parent.width - 14px; y: parent.height - 14px;
                        width: 14px; height: 14px;
                        background: transparent;
                        Path {
                            visible: overlay-drag-touch.has-hover || overlay-resize-touch.has-hover || root.overlay-resizing;
                            width: 12px; height: 12px; x: 1px; y: 1px;
                            viewbox-width: 12; viewbox-height: 12;
                            commands: "M 3 11 L 11 3 M 7 11 L 11 7";
                            stroke: #ffffffaa; stroke-width: 1.2px;
                        }
                        overlay-resize-touch := TouchArea {
                            mouse-cursor: MouseCursor.nwse-resize;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.overlay-resizing = true;
                                    root.overlay-resize-start-w = root.overlay-width;
                                    root.overlay-resize-start-h = root.overlay-height;
                                    root.overlay-resize-start-mx = network-card.x + parent.x + self.mouse-x;
                                    root.overlay-resize-start-my = network-card.y + parent.y + self.mouse-y;
                                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                    if root.overlay-resizing {
                                        root.overlay-resizing = false;
                                        root.save-network-overlay-config();
                                    }
                                }
                            }
                            moved => {
                                if root.overlay-resizing {
                                    let cur-mx = network-card.x + parent.x + self.mouse-x;
                                    let cur-my = network-card.y + parent.y + self.mouse-y;
                                    root.overlay-width = clamp(
                                        root.overlay-resize-start-w + (cur-mx - root.overlay-resize-start-mx),
                                        88px, min(460px, video.width - 8px));
                                    root.overlay-height = clamp(
                                        root.overlay-resize-start-h + (cur-my - root.overlay-resize-start-my),
                                        36px, min(460px, video.height - 8px));
                                }
                            }
                            scroll-event(event) => { accept }
                        }
                    }
                }

                // =============================================================
                // Fullscreen floating ball: ONLY appears in fullscreen mode.
                // Click opens the control center; drag repositions & docks left/right.
                // =============================================================
                if root.fullscreen-enabled && !root.fullscreen-transitioning: Rectangle {
                    x: root.ball-x;
                    y: root.ball-y;
                    width: root.ball-size;
                    height: root.ball-size;
                    border-radius: root.ball-size / 2;
                    background: root.control-center-open ? #fffffffa : #fffffff0;
                    border-width: 1px;
                    border-color: #00000022;
                    opacity: root.ball-idle ? 0.55 : 0.96;
                    drop-shadow-blur: 10px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-color: #00000033;
                    z: 12;
                    animate x, opacity { duration: 150ms; easing: ease-out; }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px;
                        height: 24px * 76 / 104;
                        source: @image-url("../../../resources/linux/farlink_128x128.png");
                        source-clip-x: 12; source-clip-y: 26;
                        source-clip-width: 104; source-clip-height: 76;
                        image-fit: contain;
                    }

                    ball-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        changed has-hover => { root.ball-hovered = self.has-hover; }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                root.ball-drag-pending = true;
                                root.ball-dragging = false;
                                root.ball-drag-start-x = root.ball-x + self.mouse-x;
                                root.ball-drag-start-y = root.ball-y + self.mouse-y;
                                root.ball-press-x = self.mouse-x;
                                root.ball-press-y = self.mouse-y;
                            }
                        }
                        scroll-event(event) => { accept }
                    }
                }

                // Click-away backdrop for control center menu.
                if root.control-center-open: TouchArea {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    z: 11;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.close-control-menus();
                        }
                    }
                    scroll-event(event) => { accept }
                }

                // =============================================================
                // Control Center Primary Menu (1:1 against Reference Images #1-#7)
                // =============================================================
                if root.control-center-open: CcMenuSurface {
                    x: root.cc-menu-x;
                    y: root.cc-menu-y;
                    width: root.cc-menu-width;
                    height: root.cc-menu-height;
                    z: 13;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 0px;
                        CcMenuRow {
                            glyph: "\u{f108}";
                            label: root.current-display-label;
                            highlighted: root.cc-submenu == 0;
                            hovered => { root.cc-submenu = 0; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 0 ? -1 : 0; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f362}";
                            label: "切换下一个屏幕";
                            hint: "Ctrl+Alt+→";
                            chevron: false;
                            enabled: root.displays.length > 1;
                            hovered => { root.cc-submenu = -1; root.cc-sub3 = 0; }
                            activated => {
                                root.switch-display(root.displays.length > 0
                                    ? (root.selected-display + 1 >= root.displays.length
                                        ? 0 : root.selected-display + 1) : 0);
                                root.close-control-menus();
                            }
                        }
                        CcDivider {}
                        CcMenuRow {
                            glyph: "\u{f03e}";
                            label: "画质";
                            highlighted: root.cc-submenu == 1;
                            hovered => { root.cc-submenu = 1; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 1 ? -1 : 1; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f2d0}";
                            label: "窗口";
                            highlighted: root.cc-submenu == 2;
                            hovered => { root.cc-submenu = 2; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 2 ? -1 : 2; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f028}";
                            label: "声音";
                            highlighted: root.cc-submenu == 3;
                            hovered => { root.cc-submenu = 3; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 3 ? -1 : 3; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f3ed}";
                            label: "安全";
                            highlighted: root.cc-submenu == 4;
                            hovered => { root.cc-submenu = 4; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 4 ? -1 : 4; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f8cc}";
                            label: "外设";
                            highlighted: root.cc-submenu == 5;
                            hovered => { root.cc-submenu = 5; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 5 ? -1 : 5; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f0ad}";
                            label: "工具";
                            highlighted: root.cc-submenu == 6;
                            hovered => { root.cc-submenu = 6; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 6 ? -1 : 6; root.cc-sub3 = 0; }
                        }
                        CcMenuRow {
                            glyph: "\u{f141}";
                            label: "更多";
                            highlighted: root.cc-submenu == 7;
                            hovered => { root.cc-submenu = 7; root.cc-sub3 = 0; }
                            activated => { root.cc-submenu = root.cc-submenu == 7 ? -1 : 7; root.cc-sub3 = 0; }
                        }
                        CcDivider {}
                        CcMenuRow {
                            glyph: root.fullscreen-enabled ? "\u{f066}" : "\u{f065}";
                            label: root.fullscreen-enabled ? "退出全屏" : "全屏";
                            hint: "Ctrl+Alt+F";
                            chevron: false;
                            hovered => { root.cc-submenu = -1; root.cc-sub3 = 0; }
                            activated => { root.toggle-fullscreen(); root.close-control-menus(); }
                        }
                        CcDivider {}
                        CcMenuRow {
                            glyph: "\u{f2f5}";
                            label: "退出远控";
                            chevron: false;
                            danger: true;
                            hovered => { root.cc-submenu = -1; root.cc-sub3 = 0; }
                            activated => { root.close-control-menus(); root.disconnect(); }
                        }
                    }
                }

                // =============================================================
                // Submenu 0: 显示屏 / 分辨率 (Reference Image #3)
                // =============================================================
                if root.control-center-open && root.cc-submenu == 0: CcMenuSurface {
                    private property <length> sub-w: 224px;
                    private property <length> sub-h: min(320px,
                        max(1, root.remote-resolutions.length) * 28px
                        + (root.displays.length > 1 ? root.displays.length * 28px + 33px : 0px)
                        + 42px);
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14; clip: true;
                    ScrollView {
                        width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding: 6px; spacing: 0px;
                            if root.displays.length > 1: CcSectionTitle { label: "显示屏"; }
                            if root.displays.length > 1: VerticalLayout {
                                spacing: 0px;
                                for disp[didx] in root.displays: CcSubItem {
                                    label: disp;
                                    checked: didx == root.selected-display;
                                    activated => { root.switch-display(didx); root.close-control-menus(); }
                                }
                            }
                            if root.displays.length > 1: CcDivider {}
                            CcSectionTitle { label: "分辨率"; }
                            for res[ridx] in root.remote-resolutions: CcSubItem {
                                label: res;
                                radio-dot: ridx == root.remote-resolution-index;
                                enabled: root.remote-resolution-enabled;
                                activated => {
                                    root.change-remote-resolution(ridx);
                                    root.close-control-menus();
                                }
                            }
                            if root.remote-resolutions.length == 0: CcSubItem {
                                label: "跟随被控端";
                                radio-dot: true;
                                enabled: false;
                            }
                        }
                    }
                }

                // =============================================================
                // Submenu 1: 画质 (Reference Image #2 — NO CrossDesk Low/Med/High
                // or FPS/Quality priority; pure bitrate tiers + FPS + true color + relay)
                // =============================================================
                if root.control-center-open && root.cc-submenu == 1: CcMenuSurface {
                    private property <length> sub-w: 272px;
                    private property <length> sub-h: min(video.height - 16px,
                        root.bitrate-tiers.length * 28px + 28px + 9px
                        + 4 * 28px + 9px
                        + 28px + 9px
                        + 50px + 16px);
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 65px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14; clip: true;

                    ScrollView {
                        width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding: 6px; spacing: 0px;
                            // Editable bitrate tiers (default: 自动（原画）, 原画 30M, 超清 14M, 高清 8M)
                            for tier[tidx] in root.bitrate-tiers: CcSubItem {
                                label: tier.label;
                                radio-dot: tidx == root.bitrate-cap-index;
                                enabled: root.bitrate-cap-enabled;
                                activated => { root.choose-bitrate-cap(tidx); }
                            }
                            CcSubItem {
                                label: "编辑码率档位…";
                                left-glyph: "\u{f304}";
                                activated => {
                                    root.tier-editor-error = "";
                                    root.close-control-menus();
                                    root.bitrate-editor-open = true;
                                }
                            }
                            CcDivider {}
                            // Frame-rate tiers (exact reference order: 144 / 90 / 60 / 30 帧)
                            CcSubItem {
                                label: "144 帧";
                                radio-dot: root.frame-rate-index == 4;
                                enabled: root.video-settings-enabled && root.high-fps-supported && root.display-max-frame-rate >= 144;
                                activated => { root.change-video-settings(2, 4, 2); }
                            }
                            CcSubItem {
                                label: "90 帧";
                                radio-dot: root.frame-rate-index == 2;
                                enabled: root.video-settings-enabled && root.high-fps-supported && root.display-max-frame-rate >= 90;
                                activated => { root.change-video-settings(2, 2, 2); }
                            }
                            CcSubItem {
                                label: "60 帧";
                                radio-dot: root.frame-rate-index == 1;
                                enabled: root.video-settings-enabled;
                                activated => { root.change-video-settings(2, 1, 2); }
                            }
                            CcSubItem {
                                label: "30 帧";
                                radio-dot: root.frame-rate-index == 0;
                                enabled: root.video-settings-enabled;
                                activated => { root.change-video-settings(2, 0, 2); }
                            }
                            CcDivider {}
                            CcSubItem {
                                label: "真彩模式 4:4:4";
                                checked: root.true-color-enabled;
                                activated => { root.toggle-true-color(!root.true-color-enabled); }
                            }
                            CcDivider {}
                            CcSubItem {
                                label: "使用安全中转连接";
                                detail: "画面卡顿时，可提升流畅度，仅本次远控生效。";
                                checked: root.force-relay-enabled;
                                activated => { root.toggle-force-relay(!root.force-relay-enabled); }
                            }
                        }
                    }
                }

                // =============================================================
                // Submenu 2: 窗口 (Reference Image #4)
                // =============================================================
                if root.control-center-open && root.cc-submenu == 2: CcMenuSurface {
                    private property <length> sub-w: 220px;
                    private property <length> sub-h: 132px;
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 93px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14;
                    VerticalLayout {
                        padding: 6px; spacing: 0px;
                        CcSubItem {
                            label: "自适应";
                            radio-dot: !root.window-scale-actual;
                            activated => { root.window-scale-actual = false; }
                        }
                        CcSubItem {
                            label: "实际大小 1:1";
                            radio-dot: root.window-scale-actual;
                            activated => { root.window-scale-actual = true; }
                        }
                        CcDivider {}
                        CcSubItem {
                            label: root.fullscreen-enabled ? "退出全屏" : "全屏";
                            hint: "Ctrl+Alt+F";
                            activated => { root.toggle-fullscreen(); root.close-control-menus(); }
                        }
                        CcSubItem {
                            label: "最小化窗口";
                            activated => { root.minimize-stream-window(); root.close-control-menus(); }
                        }
                    }
                }

                // =============================================================
                // Submenu 3: 声音 (Reference Image #5 — live volume slider)
                // =============================================================
                if root.control-center-open && root.cc-submenu == 3: CcMenuSurface {
                    private property <length> sub-w: 268px;
                    private property <length> sub-h: 84px;
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 121px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14;
                    VerticalLayout {
                        padding: 6px; spacing: 2px;
                        CcSliderRow {
                            label: "音量";
                            left-glyph: root.audio-enabled && root.audio-volume-percent > 0 ? "\u{f028}" : "\u{f6a9}";
                            minimum: 0; maximum: 100;
                            value <=> root.audio-volume-percent;
                            value-text: round(root.audio-volume-percent) + "%";
                            icon-clicked => { root.toggle-audio(); }
                            edited(v) => { root.change-audio-volume(round(v)); }
                            committed(v) => { root.change-audio-volume(round(v)); }
                        }
                        CcSubItem {
                            label: "播放被控端声音";
                            checked: root.audio-enabled;
                            activated => { root.toggle-audio(); }
                        }
                    }
                }

                // =============================================================
                // Submenu 4: 安全 (Reference Image #6)
                // =============================================================
                if root.control-center-open && root.cc-submenu == 4: CcMenuSurface {
                    private property <length> sub-w: 276px;
                    private property <length> sub-h: 176px;
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 149px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14;
                    VerticalLayout {
                        padding: 6px; spacing: 0px;
                        CcSubItem {
                            label: "远程结束后，被控端自动锁屏";
                            checked: root.host-lock-on-disconnect;
                            activated => { root.toggle-host-lock-on-disconnect(!root.host-lock-on-disconnect); }
                        }
                        CcSubItem {
                            label: "被控端静音运行";
                            detail: root.host-mute-supported
                                ? (root.host-mute-enabled ? "被控端已静音。关闭后恢复被控端声音设置。" : "开启后将被控端设为静音，控制端仍可播放声音。")
                                : "当前被控端不支持静音控制。";
                            checked: root.host-mute-enabled;
                            enabled: root.host-mute-supported;
                            activated => { root.toggle-host-mute(!root.host-mute-enabled); }
                        }
                        CcSubItem {
                            label: "远程结束后，恢复被控端声音设置";
                            checked: root.host-mute-supported;
                            enabled: false;
                        }
                        CcDivider {}
                        CcSubItem {
                            label: "被控端防窥模式";
                            chevron: true;
                            highlighted: root.cc-sub3 == 2;
                            hovered => { root.cc-sub3 = 2; }
                            activated => { root.cc-sub3 = root.cc-sub3 == 2 ? 0 : 2; }
                        }
                    }
                }

                // 3rd-level flyout for 安全 -> 被控端防窥模式 (Reference Image #6)
                if root.control-center-open && root.cc-submenu == 4 && root.cc-sub3 == 2: CcMenuSurface {
                    private property <length> sub2-x: root.flyout-x(276px);
                    private property <length> sub3-w: 176px;
                    private property <length> sub3-h: 96px;
                    x: self.sub2-x + 276px + 4px + self.sub3-w <= video.width - 6px
                        ? self.sub2-x + 276px + 4px
                        : max(6px, self.sub2-x - self.sub3-w - 4px);
                    y: root.flyout-y(root.cc-menu-y + 260px, self.sub3-h);
                    width: self.sub3-w;
                    height: self.sub3-h;
                    z: 15;
                    VerticalLayout {
                        padding: 6px; spacing: 0px;
                        CcSubItem {
                            label: "不启用";
                            radio-dot: !root.privacy-active;
                            enabled: root.privacy-can-toggle;
                            activated => { if root.privacy-active { root.toggle-privacy(); } }
                        }
                        CcSubItem {
                            label: "隐私屏保";
                            radio-dot: root.privacy-active;
                            enabled: root.privacy-can-toggle;
                            activated => { if !root.privacy-active { root.toggle-privacy(); } }
                        }
                        CcSubItem {
                            label: root.privacy-status-text;
                            enabled: false;
                        }
                    }
                }

                // =============================================================
                // Submenu 5: 外设 (Reference Image #7)
                // =============================================================
                if root.control-center-open && root.cc-submenu == 5: CcMenuSurface {
                    private property <length> sub-w: 288px;
                    private property <length> sub-h: min(video.height - 16px, 316px);
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 177px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14; clip: true;
                    ScrollView {
                        width: parent.width; height: parent.height;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding: 6px; spacing: 0px;
                            CcSectionTitle { label: "键盘"; }
                            CcSubItem {
                                label: "发送系统快捷键到被控端";
                                detail: "开启时，系统快捷键（如 Alt+Tab）将传给被控端。";
                                checked: root.keyboard-shortcut-index == 0;
                                enabled: root.keyboard-shortcut-row-visible;
                                activated => {
                                    root.choose-keyboard-shortcut(root.keyboard-shortcut-index == 0 ? 1 : 0);
                                }
                            }
                            if root.secure-attention-supported: CcSubItem {
                                label: "发送 Ctrl+Alt+Del";
                                left-glyph: "\u{f11c}";
                                activated => { root.send-shortcut("Ctrl+Alt+Del"); root.close-control-menus(); }
                            }
                            if root.secure-attention-supported: CcSubItem {
                                label: "发送 Win+L 锁屏";
                                left-glyph: "\u{f023}";
                                activated => { root.send-shortcut("Win+L"); root.close-control-menus(); }
                            }
                            CcDivider {}
                            CcSectionTitle { label: "鼠标"; }
                            CcSubItem {
                                label: "鼠标模式";
                                left-glyph: "\u{f8cc}";
                                chevron: true;
                                highlighted: root.cc-sub3 == 3;
                                hovered => { root.cc-sub3 = 3; }
                                activated => { root.cc-sub3 = root.cc-sub3 == 3 ? 0 : 3; }
                            }
                            CcSubItem {
                                label: "鼠标脱离";
                                hint: StreamStrings.escape-chord;
                                left-glyph: "\u{f245}";
                                activated => { root.release-pointer(); root.close-control-menus(); }
                            }
                            CcSliderRow {
                                label: "指针速度";
                                minimum: 25; maximum: 300;
                                value <=> root.mouse-sensitivity-percent;
                                value-text: round(root.mouse-sensitivity-percent) + "%";
                                committed(v) => { root.commit-input-sensitivity(); }
                            }
                            CcSliderRow {
                                label: "滚轮速度";
                                minimum: 25; maximum: 300;
                                value <=> root.wheel-sensitivity-percent;
                                value-text: round(root.wheel-sensitivity-percent) + "%";
                                committed(v) => { root.commit-input-sensitivity(); }
                            }
                        }
                    }
                }

                // 3rd-level flyout for 外设 -> 鼠标模式 (Reference Image #7)
                if root.control-center-open && root.cc-submenu == 5 && root.cc-sub3 == 3: CcMenuSurface {
                    private property <length> sub2-x: root.flyout-x(288px);
                    private property <length> sub3-w: 264px;
                    private property <length> sub3-h: 196px;
                    x: self.sub2-x + 288px + 4px + self.sub3-w <= video.width - 6px
                        ? self.sub2-x + 288px + 4px
                        : max(6px, self.sub2-x - self.sub3-w - 4px);
                    y: root.flyout-y(root.cc-menu-y + 275px, self.sub3-h);
                    width: self.sub3-w;
                    height: self.sub3-h;
                    z: 15;
                    VerticalLayout {
                        padding: 6px; spacing: 0px;
                        CcSubItem {
                            label: "游戏鼠标（相对模式）";
                            detail: "相对移动，不受本机屏幕边缘限制；按 ⌃⌥G 脱离。";
                            radio-dot: root.game-mouse-active;
                            enabled: root.game-mouse-available && root.mouse-control-enabled;
                            activated => { if !root.game-mouse-active { root.toggle-game-mouse(); } root.close-control-menus(); }
                        }
                        CcSubItem {
                            label: "常规鼠标（绝对模式）";
                            detail: "跟手性好，与本机光标一一对应。";
                            radio-dot: root.mouse-control-enabled && !root.game-mouse-active;
                            activated => {
                                if !root.mouse-control-enabled { root.toggle-mouse-control(); }
                                else if root.game-mouse-active { root.toggle-game-mouse(); }
                                root.close-control-menus();
                            }
                        }
                        CcSubItem {
                            label: "仅查看（禁用鼠标控制）";
                            detail: "不向被控端发送键鼠操作。";
                            radio-dot: !root.mouse-control-enabled;
                            activated => { if root.mouse-control-enabled { root.toggle-mouse-control(); } root.close-control-menus(); }
                        }
                    }
                }

                // =============================================================
                // Submenu 6: 工具
                // =============================================================
                if root.control-center-open && root.cc-submenu == 6: CcMenuSurface {
                    private property <length> sub-w: 224px;
                    private property <length> sub-h: 146px;
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 205px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14;
                    VerticalLayout {
                        padding: 6px; spacing: 0px;
                        CcSubItem {
                            label: "显示网络状态";
                            checked: root.stats-visible;
                            activated => { root.toggle-stats(); }
                        }
                        CcSubItem {
                            label: "网络状态框设置…";
                            left-glyph: "\u{f1de}";
                            activated => {
                                root.close-control-menus();
                                root.network-settings-open = true;
                            }
                        }
                        CcDivider {}
                        CcSubItem {
                            label: "发送文件…";
                            left-glyph: "\u{f07c}";
                            activated => { root.close-control-menus(); root.select-file(); }
                        }
                        CcSubItem {
                            label: "复制全部网络信息";
                            left-glyph: "\u{f0c5}";
                            activated => { root.copy-stats(); root.close-control-menus(); }
                        }
                    }
                }

                // =============================================================
                // Submenu 7: 更多
                // =============================================================
                if root.control-center-open && root.cc-submenu == 7: CcMenuSurface {
                    private property <length> sub-w: 210px;
                    private property <length> sub-h: 100px;
                    x: root.flyout-x(self.sub-w);
                    y: root.flyout-y(root.cc-menu-y + 233px, self.sub-h);
                    width: self.sub-w;
                    height: self.sub-h;
                    z: 14;
                    VerticalLayout {
                        padding: 6px; spacing: 0px;
                        CcSubItem {
                            label: root.diagnostic-exporting ? "正在导出诊断…" : "导出诊断日志";
                            left-glyph: "\u{f188}";
                            enabled: !root.diagnostic-exporting;
                            activated => { root.export-diagnostics(); root.close-control-menus(); }
                        }
                        CcDivider {}
                        CcSubItem {
                            label: "Farlink 1.7.7";
                            enabled: false;
                        }
                    }
                }

                // =============================================================
                // Modal backdrop
                // =============================================================
                if root.modal-visible: Rectangle {
                    width: parent.width; height: parent.height;
                    background: #0c162c52;
                    z: 18;
                    TouchArea {
                        mouse-cursor: MouseCursor.default;
                        scroll-event(event) => { accept }
                    }
                }

                // =============================================================
                // Modal: 编辑码率档位 (add / edit Mbps / delete / reset defaults)
                // =============================================================
                if root.bitrate-editor-open: DialogSurface {
                    x: (parent.width - self.width) / 2;
                    y: max(16px, (parent.height - self.height) / 2);
                    width: min(420px, parent.width - 32px);
                    height: min(440px, parent.height - 32px);
                    outline-color: UiSurface.edge;
                    border-radius: 12px;
                    z: 20;
                    TouchArea { scroll-event(event) => { accept } }

                    Text {
                        x: 20px; y: 16px; width: parent.width - 60px; height: 24px;
                        text: "编辑码率档位";
                        font-size: 15px; font-weight: 600; color: CcTheme.text;
                        vertical-alignment: center;
                    }
                    IconButton {
                        x: parent.width - 38px; y: 12px; width: 28px; height: 28px;
                        icon: FontAwesomeIcons.xmark; icon-size: 13px;
                        icon-color: ControlStyle.icon; normal-background: ControlStyle.surface;
                        clicked => { root.bitrate-editor-open = false; }
                    }

                    ScrollView {
                        x: 16px; y: 48px;
                        width: parent.width - 32px;
                        height: parent.height - 172px;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-right: 12px; spacing: 6px;
                            for tier[tidx] in root.bitrate-tiers: Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: #f5f5f7;
                                Text {
                                    x: 10px; width: 120px; height: parent.height;
                                    text: tier.name; font-size: 13px; color: CcTheme.text;
                                    vertical-alignment: center; overflow: elide;
                                }
                                Text {
                                    x: 136px; width: 72px; height: parent.height;
                                    text: tier.mbps <= 0 ? "自动" : tier.mbps + " Mbps";
                                    font-size: 12px; font-weight: 600; color: CcTheme.accent;
                                    vertical-alignment: center;
                                }
                                if tier.mbps > 0: SecondaryButton {
                                    x: parent.width - 134px; y: 4px; width: 32px; height: 26px;
                                    text: "-2";
                                    clicked => { root.update-bitrate-tier(tidx, tier.name, max(1, tier.mbps - 2)); }
                                }
                                if tier.mbps > 0: SecondaryButton {
                                    x: parent.width - 96px; y: 4px; width: 32px; height: 26px;
                                    text: "+2";
                                    clicked => { root.update-bitrate-tier(tidx, tier.name, min(100, tier.mbps + 2)); }
                                }
                                if tier.mbps > 0: SecondaryButton {
                                    x: parent.width - 56px; y: 4px; width: 48px; height: 26px;
                                    text: "删除";
                                    clicked => { root.remove-bitrate-tier(tidx); }
                                }
                            }
                        }
                    }

                    // Add new tier row
                    Rectangle {
                        x: 16px; y: parent.height - 114px;
                        width: parent.width - 32px; height: 34px;
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 2;
                                placeholder-text: "档位名（如 蓝光）";
                                text <=> root.new-tier-name;
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Mbps(1-100)";
                                text <=> root.new-tier-mbps;
                            }
                            PrimaryButton {
                                width: 64px; height: 32px;
                                text: "添加";
                                clicked => {
                                    let mbps = root.new-tier-mbps.to-float();
                                    if mbps >= 1 && mbps <= 100 {
                                        root.tier-editor-error = "";
                                        root.add-bitrate-tier(
                                            root.new-tier-name == "" ? "自定义" : root.new-tier-name,
                                            round(mbps));
                                        root.new-tier-name = "";
                                    } else {
                                        root.tier-editor-error = "码率需在 1–100 Mbps 之间";
                                    }
                                }
                            }
                        }
                    }
                    if root.tier-editor-error != "": Text {
                        x: 18px; y: parent.height - 76px; width: parent.width - 36px; height: 18px;
                        text: root.tier-editor-error; font-size: 11px; color: CcTheme.danger;
                    }
                    SecondaryButton {
                        x: 16px; y: parent.height - 48px; width: 96px; height: 32px;
                        text: "恢复默认";
                        clicked => { root.reset-bitrate-tiers(); }
                    }
                    PrimaryButton {
                        x: parent.width - 96px; y: parent.height - 48px; width: 80px; height: 32px;
                        text: "完成";
                        clicked => { root.bitrate-editor-open = false; }
                    }
                }

                // =============================================================
                // Modal: 网络状态框设置 (position/size/font/opacity/layout/fields)
                // =============================================================
                if root.network-settings-open: DialogSurface {
                    x: (parent.width - self.width) / 2;
                    y: max(16px, (parent.height - self.height) / 2);
                    width: min(430px, parent.width - 32px);
                    height: min(510px, parent.height - 32px);
                    outline-color: UiSurface.edge;
                    border-radius: 12px;
                    z: 20;
                    TouchArea { scroll-event(event) => { accept } }

                    Text {
                        x: 20px; y: 16px; width: parent.width - 60px; height: 24px;
                        text: "网络状态框设置";
                        font-size: 15px; font-weight: 600; color: CcTheme.text;
                        vertical-alignment: center;
                    }
                    IconButton {
                        x: parent.width - 38px; y: 12px; width: 28px; height: 28px;
                        icon: FontAwesomeIcons.xmark; icon-size: 13px;
                        icon-color: ControlStyle.icon; normal-background: ControlStyle.surface;
                        clicked => { root.network-settings-open = false; }
                    }

                    ScrollView {
                        x: 16px; y: 48px;
                        width: parent.width - 32px;
                        height: parent.height - 108px;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-right: 12px; spacing: 4px;
                            CcSubItem {
                                label: "显示网络状态框";
                                checked: root.stats-visible;
                                activated => { root.toggle-stats(); }
                            }
                            CcSectionTitle { label: "布局格式"; }
                            HorizontalLayout {
                                spacing: 8px; height: 30px;
                                padding-left: 10px; padding-right: 10px;
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 6px;
                                    background: root.overlay-layout-mode == 0 ? CcTheme.accent : #ebebf0;
                                    Text {
                                        text: "竖排多行"; font-size: 12px;
                                        color: root.overlay-layout-mode == 0 ? white : CcTheme.text;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.overlay-layout-mode = 0; root.save-network-overlay-config(); }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; border-radius: 6px;
                                    background: root.overlay-layout-mode == 1 ? CcTheme.accent : #ebebf0;
                                    Text {
                                        text: "横排紧凑"; font-size: 12px;
                                        color: root.overlay-layout-mode == 1 ? white : CcTheme.text;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.overlay-layout-mode = 1; root.save-network-overlay-config(); }
                                    }
                                }
                            }
                            CcSectionTitle { label: "外观与尺寸（也可直接拖动和拉伸悬浮框）"; }
                            CcSliderRow {
                                label: "字体大小"; minimum: 8; maximum: 24;
                                value: root.overlay-font-size;
                                value-text: root.overlay-font-size + "px";
                                edited(v) => { root.overlay-font-size = round(v); }
                                committed(v) => { root.overlay-font-size = round(v); root.save-network-overlay-config(); }
                            }
                            CcSliderRow {
                                label: "透明度"; minimum: 20; maximum: 100;
                                value: root.overlay-opacity-percent;
                                value-text: root.overlay-opacity-percent + "%";
                                edited(v) => { root.overlay-opacity-percent = round(v); }
                                committed(v) => { root.overlay-opacity-percent = round(v); root.save-network-overlay-config(); }
                            }
                            CcSliderRow {
                                label: "宽度"; minimum: 88; maximum: 420;
                                value: root.overlay-width / 1px;
                                value-text: round(root.overlay-width / 1px) + "";
                                edited(v) => { root.overlay-width = round(v) * 1px; }
                                committed(v) => { root.overlay-width = round(v) * 1px; root.save-network-overlay-config(); }
                            }
                            CcSliderRow {
                                label: "高度"; minimum: 36; maximum: 420;
                                value: root.overlay-height / 1px;
                                value-text: round(root.overlay-height / 1px) + "";
                                edited(v) => { root.overlay-height = round(v) * 1px; }
                                committed(v) => { root.overlay-height = round(v) * 1px; root.save-network-overlay-config(); }
                            }
                            CcSectionTitle { label: "显示栏目"; }
                            CcSubItem { label: "时间 (HH:MM:SS)"; checked: root.overlay-show-clock; activated => { root.overlay-show-clock = !root.overlay-show-clock; root.save-network-overlay-config(); } }
                            CcSubItem { label: "传输通道 (UDP LAN / RELAY)"; checked: root.overlay-show-transport; activated => { root.overlay-show-transport = !root.overlay-show-transport; root.save-network-overlay-config(); } }
                            CcSubItem { label: "帧率 (fps)"; checked: root.overlay-show-fps; activated => { root.overlay-show-fps = !root.overlay-show-fps; root.save-network-overlay-config(); } }
                            CcSubItem { label: "实时码率 (Mbps)"; checked: root.overlay-show-bitrate; activated => { root.overlay-show-bitrate = !root.overlay-show-bitrate; root.save-network-overlay-config(); } }
                            CcSubItem { label: "网络延时 (RTT)"; checked: root.overlay-show-rtt; activated => { root.overlay-show-rtt = !root.overlay-show-rtt; root.save-network-overlay-config(); } }
                            CcSubItem { label: "帧延时 (ms frm.)"; checked: root.overlay-show-frame-latency; activated => { root.overlay-show-frame-latency = !root.overlay-show-frame-latency; root.save-network-overlay-config(); } }
                            CcSubItem { label: "丢包率 (loss)"; checked: root.overlay-show-loss; activated => { root.overlay-show-loss = !root.overlay-show-loss; root.save-network-overlay-config(); } }
                            CcSubItem { label: "分辨率与画质档位"; checked: root.overlay-show-resolution-tier; activated => { root.overlay-show-resolution-tier = !root.overlay-show-resolution-tier; root.save-network-overlay-config(); } }
                            CcSubItem { label: "编解码器"; checked: root.overlay-show-codec; activated => { root.overlay-show-codec = !root.overlay-show-codec; root.save-network-overlay-config(); } }
                            CcSubItem { label: "端点地址"; checked: root.overlay-show-endpoints; activated => { root.overlay-show-endpoints = !root.overlay-show-endpoints; root.save-network-overlay-config(); } }
                        }
                    }

                    SecondaryButton {
                        x: 16px; y: parent.height - 46px; width: 96px; height: 32px;
                        text: "恢复默认";
                        clicked => { root.reset-network-overlay-config(); }
                    }
                    PrimaryButton {
                        x: parent.width - 96px; y: parent.height - 46px; width: 80px; height: 32px;
                        text: "完成";
                        clicked => { root.save-network-overlay-config(); root.network-settings-open = false; }
                    }
                }

                // Transient notices
                if root.service-warning != "" && !root.service-warning-expired && !root.modal-visible: FlatSurface {
                    x: (parent.width - self.width) / 2; y: 12px;
                    width: min(600px, parent.width - 32px);
                    height: service-warning-text.preferred-height + 20px;
                    background: #fff4d6; outline-color: #e8c56a; border-radius: UiRadius.surface; z: 12;
                    Timer { interval: 3s; triggered => { root.service-warning-expired = true; } }
                    service-warning-text := Text {
                        x: 12px; y: 10px; width: parent.width - 24px;
                        text: root.service-warning; color: #805b12; font-size: 12px; wrap: word-wrap;
                    }
                }
                if root.game-mouse-notice-visible: FlatSurface {
                    x: (parent.width - self.width) / 2; y: 12px;
                    width: min(game-mouse-notice-measure.preferred-width + 24px, parent.width - 32px);
                    height: game-mouse-notice-text.preferred-height + 20px;
                    background: #fff4d6; outline-color: #e8c56a; border-radius: UiRadius.surface; z: 12;
                    game-mouse-notice-measure := Text {
                        visible: false;
                        text: StreamStrings.release-game-mouse + " · " + StreamStrings.escape-chord;
                        font-size: 12px;
                    }
                    game-mouse-notice-text := Text {
                        x: 12px; y: 10px; width: parent.width - 24px;
                        text: StreamStrings.release-game-mouse + " · " + StreamStrings.escape-chord;
                        color: #805b12; font-size: 12px; wrap: word-wrap;
                    }
                }
                if root.privacy-unlock-visible: DialogSurface {
                    x: (parent.width - self.width) / 2; y: max(16px, (parent.height - self.height) / 2);
                    width: min(460px, parent.width - 32px);
                    height: unlock-message.y + unlock-message.height + 84px;
                    outline-color: UiSurface.edge; border-radius: UiRadius.surface; z: 20;
                    TouchArea { scroll-event(event) => { accept } }
                    unlock-title := Text {
                        x: 24px; y: 24px; width: parent.width - 48px; height: max(28px, self.preferred-height);
                        text: StreamStrings.privacy-unlocked-title; color: #1b2433; font-size: 20px; font-weight: 600; wrap: word-wrap;
                    }
                    unlock-message := Text {
                        x: 24px; y: unlock-title.y + unlock-title.height + 8px;
                        width: parent.width - 48px; height: max(22px, self.preferred-height);
                        text: StreamStrings.privacy-unlocked-message; color: #667085; font-size: 15px; wrap: word-wrap;
                    }
                    SecondaryButton {
                        x: parent.width - 244px; y: parent.height - 60px; width: 104px; height: 36px;
                        text: StreamStrings.privacy-unlock-confirm;
                        clicked => { root.dismiss-privacy-unlock(); }
                    }
                    PrimaryButton {
                        x: parent.width - 128px; y: parent.height - 60px; width: 104px; height: 36px;
                        text: StreamStrings.privacy-unlock-lock; enabled: root.privacy-can-lock;
                        clicked => { root.lock-privacy(); }
                    }
                }
                remote-update-banner := DialogSurface {
                    visible: root.remote-update-visible && !root.privacy-unlock-visible;
                    x: (parent.width - self.width) / 2;
                    y: min(max(64px, parent.height * 0.18), max(16px, parent.height - self.height - 16px));
                    width: min(400px, parent.width - 48px);
                    height: remote-update-message.y + remote-update-message.height + 84px;
                    outline-color: UiSurface.edge; border-radius: UiRadius.surface; z: 20;
                    TouchArea { mouse-cursor: MouseCursor.default; scroll-event(event) => { accept } }
                    remote-update-title := Text {
                        x: 24px; y: 24px; width: parent.width - 80px; height: max(28px, self.preferred-height);
                        text: StreamStrings.remote-update-title; color: #1b2433; font-size: 20px; font-weight: 600; wrap: word-wrap;
                    }
                    remote-update-message := Text {
                        x: remote-update-title.x; y: remote-update-title.y + remote-update-title.height + 8px;
                        width: parent.width - 48px; height: max(22px, self.preferred-height);
                        text: StreamStrings.remote-update; color: #667085; font-size: 15px; wrap: word-wrap;
                    }
                    IconButton {
                        x: parent.width - 44px; y: 12px; width: 32px; height: 32px;
                        icon: FontAwesomeIcons.xmark; icon-size: 14px;
                        icon-color: ControlStyle.icon; normal-background: ControlStyle.surface;
                        clicked => { root.dismiss-remote-update(); }
                    }
                    PrimaryButton {
                        x: parent.width - 128px; y: parent.height - 60px; width: 104px; height: 36px;
                        border-radius: UiRadius.control; text: StreamStrings.remote-update-dismiss; text-size: 14px;
                        clicked => { root.dismiss-remote-update(); }
                    }
                }

                // Transfer progress overlay at bottom-left.
                if root.file-transfer-visible: FlatSurface {
                    x: root.file-panel-x; y: root.file-panel-y;
                    width: root.file-panel-width; height: root.file-panel-height;
                    background: white; outline-color: UiSurface.edge; border-radius: UiRadius.surface; z: 7;
                    TouchArea { mouse-cursor: MouseCursor.default; scroll-event(event) => { accept } }
                    Text { x: 12px; y: 8px; text: StreamStrings.file-transfer; color: #2d3138; font-weight: 600; }
                    IconButton {
                        x: parent.width - 32px; y: 1px; icon: FontAwesomeIcons.xmark; icon-size: 13px;
                        normal-background: ControlStyle.surface;
                        clicked => { root.close-file-transfer(); }
                    }
                    ScrollView {
                        x: 10px; y: 32px; width: parent.width - 20px; height: parent.height - 42px;
                        VerticalLayout {
                            padding-right: 16px; spacing: 8px;
                            for entry in root.file-transfers: VerticalLayout {
                                spacing: 3px;
                                HorizontalLayout { height: 18px; Text { text: entry.name; color: #30343b; font-size: ImGuiFontStyle.body; overflow: elide; } Text { width: 80px; text: entry.status; color: #5c6470; font-size: ImGuiFontStyle.body; horizontal-alignment: right; } }
                                Rectangle {
                                    height: 7px; background: #dfe3e8; border-radius: 3px;
                                    Rectangle { x: 0px; y: 0px; width: parent.width * max(0, min(1, entry.progress)); height: parent.height; background: #2463c7; border-radius: 3px; }
                                }
                                HorizontalLayout {
                                    height: 14px;
                                    Text { text: round(entry.progress * 100) + "%  " + entry.speed; color: #6a717c; font-size: ImGuiFontStyle.small; }
                                    Text { text: entry.size; color: #6a717c; font-size: ImGuiFontStyle.small; horizontal-alignment: right; }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.custom-titlebar && !root.fullscreen-enabled: FlatSurface {
            width: parent.width; height: parent.height;
            background: transparent; outline-color: UiSurface.edge;
            border-radius: root.window-maximized ? 0px : root.window-corner-radius;
            z: 200;
        }
    }
}
