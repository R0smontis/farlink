export struct FileTransferEntry {
    name: string,
    status: string,
    progress: float,
    speed: string,
    size: string,
}

export struct NetworkStatsRow {
    label: string,
    inbound: string,
    outbound: string,
    loss-rate: string,
}

export struct BitrateTierEntry {
    name: string,
    mbps: int,
    label: string,
}

